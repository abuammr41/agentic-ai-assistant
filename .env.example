# Fill in ONE of these two keys (whichever provider you want to use).
# Then: copy .env.example .env   and put your real key in .env (not this file).

# Option 1: Anthropic Claude
ANTHROPIC_API_KEY=

# Option 2: Google Gemini (has a free tier)
GEMINI_API_KEY=

# Optional: force a specific provider. If left blank, the agent picks
# Claude if ANTHROPIC_API_KEY is set, otherwise Gemini.
AGENT_PROVIDER=
